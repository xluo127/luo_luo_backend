generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model NavNode {
  id        Int       @id @default(autoincrement())
  title     String    
  url       String?   
  parentId  Int?      
  parent    NavNode?  @relation("NodeToNode", fields: [parentId], references: [id])
  children  NavNode[] @relation("NodeToNode")
  createdAt DateTime  @default(now())
}